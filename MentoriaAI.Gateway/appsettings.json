{
  "Supabase": {
    //"Url": "",
    //"JwtSecret": ""
  },
  "ReverseProxy": {
    "Routes": {
      "cadastro": {
        "ClusterId": "cadastroCluster",
        "Match": { "Path": "/cadastro/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/cadastro" } ],
        "AuthorizationPolicy": "AllowAnonymous" // TODO: Adjust to allow only read operations and block create/edit actions
      },
      "busca": {
        "ClusterId": "buscaCluster",
        "Match": { "Path": "/busca/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/busca" } ],
        "AuthorizationPolicy": "Default"
      },
      "buscaIr": {
        "ClusterId": "buscaIrCluster",
        "Match": { "Path": "/buscair/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/buscair" } ],
        "AuthorizationPolicy": "Default"
      }
    },
    "Clusters": {
      "cadastroCluster": {
        "Destinations": {
          "cadastro": { "Address": "http://mentoria-cadastro:8080/" }
        }
      },
      "buscaCluster": {
        "Destinations": {
          "busca": { "Address": "http://mentoria-busca-semantica:8080/" }
        }
      },
      "buscaIrCluster": {
        "Destinations": {
          "buscaIr": { "Address": "http://mentoria-busca-ir:8080/" }
        }
      }
    }
  }
}
